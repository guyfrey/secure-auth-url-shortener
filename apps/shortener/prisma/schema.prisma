generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShortLink {
  id          String    @id @default(cuid())
  shortCode   String    @unique
  originalUrl String
  userId      String?   // for later auth integration
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  clicks      Int       @default(0)

  @@map("short_links")
}

model Click {
  id        String    @id @default(cuid())
  linkId    String
  clickedAt DateTime  @default(now())
  ip        String?
  country   String?
  referrer  String?
  userAgent String?

  @@map("clicks")
}